@Metadata.layer: #CUSTOMER
annotate entity ZC_FLOWFUSE_STOCK with
{
  @UI.facet: [
    {
      id: 'StockDetails',
      type: #IDENTIFICATION_REFERENCE,
      label: 'Stock Details',
      position: 10
    }
  ]

  @UI.lineItem: [{ position: 10, label: 'Stock ID' }]
  @UI.identification: [{ position: 10, label: 'Stock ID' }]
  StockId;

  @UI.lineItem: [{ position: 20, label: 'Material' }]
  @UI.identification: [{ position: 20, label: 'Material' }]
  MaterialId;

  @UI.lineItem: [{ position: 30, label: 'Location' }]
  @UI.identification: [{ position: 30, label: 'Location' }]
  LocationId;

  @UI.lineItem: [{ position: 40, label: 'Available Quantity' }]
  @UI.identification: [{ position: 40, label: 'Available Quantity' }]
  AvailableQty;

  @UI.lineItem: [{ position: 50, label: 'Safety Quantity' }]
  @UI.identification: [{ position: 50, label: 'Safety Quantity' }]
  SafetyQty;
}